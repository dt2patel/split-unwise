rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function strictId(value) { return value is string && value.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'); }
    function validName(value) { return value is string && value.size() > 0 && value.size() <= 120; }
    function validInitials(value) { return value is string && value.size() > 0 && value.size() <= 4; }
    function validAvatar(data) { return data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 2048); }
    function validProfileCore(data) {
      return data.keys().hasAll(['displayName', 'initials', 'avatarUrl', 'createdAt', 'updatedAt'])
        && validName(data.displayName) && validInitials(data.initials) && validAvatar(data)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'initials', 'avatarUrl', 'createdAt', 'updatedAt'])
        && validProfileCore(data);
    }
    function activeAccount() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && exists(path) && !('deletionStatus' in get(path).data);
    }
    function accountDeleting() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.get('deletionStatus', '') == 'deleting';
    }
    function accountDeletingInGroup(groupId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return accountDeleting() && profile.deletionGroupIds is list && groupId in profile.deletionGroupIds;
    }
    function accountDeletionGroupRead(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return accountDeletingInGroup(groupId) && group.memberIds is list && request.auth.uid in group.memberIds;
    }
    function accountDeletionOwnsPrivateData(uid) {
      return owns(uid) && accountDeleting();
    }
    function validDeletionProfileShape(data) {
      return data.keys().hasOnly([
          'displayName', 'initials', 'avatarUrl', 'createdAt', 'updatedAt',
          'deletionRequestedAt', 'deletionStatus', 'deletionId', 'deletionGroupIds'
        ])
        && data.keys().hasAll([
          'displayName', 'initials', 'avatarUrl', 'createdAt', 'updatedAt',
          'deletionRequestedAt', 'deletionStatus', 'deletionId', 'deletionGroupIds'
        ])
        && data.displayName == 'Deleted user' && data.initials == 'DU' && data.avatarUrl == null
        && data.createdAt is timestamp && data.updatedAt is timestamp && data.deletionRequestedAt is timestamp
        && data.deletionStatus in ['deleting', 'prepared']
        && data.deletionId is string && data.deletionId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$')
        && data.deletionGroupIds is list && data.deletionGroupIds.size() <= 100
        && data.deletionGroupIds.toSet().size() == data.deletionGroupIds.size();
    }
    function validDeletionProfileRequest(data) {
      return validDeletionProfileShape(data) && data.updatedAt == request.time;
    }
    function validAccountDeletionStart(data) {
      return validProfileCore(resource.data) && !('deletionStatus' in resource.data)
        && validDeletionProfileRequest(data) && data.deletionStatus == 'deleting'
        && data.createdAt == resource.data.createdAt && data.deletionRequestedAt == request.time;
    }
    function validAccountDeletionTransition(data) {
      return validDeletionProfileShape(resource.data) && validDeletionProfileRequest(data)
        && data.createdAt == resource.data.createdAt
        && data.deletionRequestedAt == resource.data.deletionRequestedAt
        && data.deletionId == resource.data.deletionId
        && data.deletionGroupIds == resource.data.deletionGroupIds
        && data.deletionStatus != resource.data.deletionStatus;
    }
    function currentAccountDeletionId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionId;
    }
    function validDeletedActor(actor) {
      return actor is map && actor.keys().hasOnly(['id', 'displayName'])
        && actor.id == request.auth.uid && actor.displayName == 'Deleted user';
    }
    function validActorAnonymization(before, after) {
      return before is map && after is map && before.id == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['displayName'])
        && after.id == before.id && validDeletedActor(after);
    }
    function validPreservedOrAnonymizedActor(before, after) {
      return after == before || validActorAnonymization(before, after);
    }
    function validExpenseActorAnonymization(before, after) {
      return before is map && after is map
        && after.diff(before).affectedKeys().hasOnly(['createdBy', 'updatedBy'])
        && validPreservedOrAnonymizedActor(before.createdBy, after.createdBy)
        && validPreservedOrAnonymizedActor(before.updatedBy, after.updatedBy);
    }
    function validOptionalExpenseCurrent(before, after) {
      return (!('current' in before) && !('current' in after))
        || ('current' in before && 'current' in after && validExpenseActorAnonymization(before.current, after.current));
    }
    function validAccountDeletionExpense(groupId, data) {
      return accountDeletingInGroup(groupId)
        && data.diff(resource.data).affectedKeys().hasOnly(['createdBy', 'updatedBy', 'current'])
        && validPreservedOrAnonymizedActor(resource.data.createdBy, data.createdBy)
        && validPreservedOrAnonymizedActor(resource.data.updatedBy, data.updatedBy)
        && validOptionalExpenseCurrent(resource.data, data);
    }
    function validAccountDeletionRevision(groupId, data) {
      return accountDeletingInGroup(groupId)
        && data.diff(resource.data).affectedKeys().hasOnly(['actor', 'expense'])
        && validPreservedOrAnonymizedActor(resource.data.actor, data.actor)
        && validExpenseActorAnonymization(resource.data.expense, data.expense);
    }
    function validAccountDeletionActivity(groupId, data) {
      return accountDeletingInGroup(groupId)
        && data.diff(resource.data).affectedKeys().hasOnly(['actor'])
        && validActorAnonymization(resource.data.actor, data.actor);
    }
    function validAccountDeletionComment(groupId, data) {
      return accountDeletingInGroup(groupId)
        && data.diff(resource.data).affectedKeys().hasOnly(['author', 'body', 'attachmentRefs'])
        && validActorAnonymization(resource.data.author, data.author)
        && data.body == 'Comment removed with deleted account' && data.attachmentRefs == [];
    }
    function validOptionalSettlementVoid(before, after) {
      return (!('void' in before) && !('void' in after))
        || ('void' in before && 'void' in after
          && after.void.diff(before.void).affectedKeys().hasOnly(['actor'])
          && validPreservedOrAnonymizedActor(before.void.actor, after.void.actor));
    }
    function validAccountDeletionSettlement(groupId, data) {
      return accountDeletingInGroup(groupId)
        && data.diff(resource.data).affectedKeys().hasOnly(['createdBy', 'void'])
        && validPreservedOrAnonymizedActor(resource.data.createdBy, data.createdBy)
        && validOptionalSettlementVoid(resource.data, data);
    }
    function validAccountDeletionRecurring(groupId, data) {
      return accountDeletingInGroup(groupId)
        && resource.data.status == 'active' && request.auth.uid in resource.data.involvedMemberIds
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'revision', 'createdBy', 'updatedBy', 'updatedAt',
          'accountDeletionId', 'accountDeletedUid'
        ])
        && data.status == 'cancelled' && data.revision == resource.data.revision + 1
        && validPreservedOrAnonymizedActor(resource.data.createdBy, data.createdBy)
        && validDeletedActor(data.updatedBy) && data.updatedAt == request.time
        && data.accountDeletionId == currentAccountDeletionId()
        && data.accountDeletedUid == request.auth.uid;
    }
    function validAccountDeletionSettings(groupId, data) {
      return accountDeletingInGroup(groupId)
        && 'defaultSplit' in resource.data && request.auth.uid in resource.data.defaultSplit.participantIds
        && !('defaultSplit' in data)
        && data.diff(resource.data).affectedKeys().hasOnly([
          'defaultSplit', 'revision', 'updatedBy', 'updatedAt', 'accountDeletionId', 'accountDeletedUid'
        ])
        && data.revision == resource.data.revision + 1 && data.updatedAt == request.time
        && validDeletedActor(data.updatedBy)
        && data.accountDeletionId == currentAccountDeletionId()
        && data.accountDeletedUid == request.auth.uid;
    }
    function validAccountDeletionSettingsActor(groupId, data) {
      return accountDeletingInGroup(groupId)
        && data.diff(resource.data).affectedKeys().hasOnly(['updatedBy'])
        && validActorAnonymization(resource.data.updatedBy, data.updatedBy);
    }
    function validSparkPrivateReplay(data, kind) {
      return data.lastCommandKind == kind
        && data.lastOperationId is string && data.lastOperationId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
        && data.lastRequestFingerprint is string && data.lastRequestFingerprint.matches('^[a-f0-9]{64}$')
        && data.lastResourceToken is string && data.lastResourceToken.matches('^[a-f0-9]{48}$');
    }
    function validSparkProfileUpdate(data) {
      return data.keys().hasOnly([
          'displayName', 'initials', 'avatarUrl', 'createdAt', 'updatedAt',
          'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && validProfileCore(data) && validSparkPrivateReplay(data, 'profile.update')
        && data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'initials', 'updatedAt',
          'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && data.avatarUrl == resource.data.avatarUrl && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time;
    }
    function validSparkNotificationPreferences(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'revision', 'emailEnabled', 'pushEnabled', 'updatedAt',
          'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'revision', 'emailEnabled', 'pushEnabled', 'updatedAt',
          'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && data.schemaVersion == 1 && data.revision is int && data.revision >= 1
        && data.emailEnabled is bool && data.pushEnabled is bool && data.updatedAt == request.time
        && validSparkPrivateReplay(data, 'notification.preferences');
    }
    function validSparkNotificationPreferencesCreate(data) {
      return validSparkNotificationPreferences(data) && data.revision == 1;
    }
    function validSparkNotificationPreferencesUpdate(data) {
      return validSparkNotificationPreferences(data)
        && data.revision == resource.data.revision + 1
        && data.lastOperationId != resource.data.lastOperationId
        && data.lastResourceToken != resource.data.lastResourceToken;
    }
    function validSparkNotificationReadReceipt(uid, notificationId, data) {
      let activity = get(/databases/$(database)/documents/groups/$(data.groupId)/activity/$(data.activityId)).data;
      return owns(uid)
        && data.keys().hasOnly([
          'schemaVersion', 'notificationId', 'groupId', 'activityId', 'sourceCreatedAt', 'readAt',
          'operationId', 'requestFingerprint', 'resourceToken'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'notificationId', 'groupId', 'activityId', 'sourceCreatedAt', 'readAt',
          'operationId', 'requestFingerprint', 'resourceToken'
        ])
        && data.schemaVersion == 1 && strictId(notificationId)
        && data.notificationId == notificationId && data.activityId == notificationId
        && strictId(data.groupId) && activeMember(data.groupId)
        && data.sourceCreatedAt is string && data.sourceCreatedAt.size() >= 20 && data.sourceCreatedAt.size() <= 40
        && data.readAt == request.time
        && data.operationId is string && data.operationId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
        && data.requestFingerprint is string && data.requestFingerprint.matches('^[a-f0-9]{64}$')
        && data.resourceToken is string && data.resourceToken.matches('^[a-f0-9]{48}$')
        && activity.groupId == data.groupId && activity.actor.id != uid && activity.createdAt is timestamp;
    }
    function validSparkNotificationReadCursor(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'revision', 'cutoffCreatedAt', 'cutoffId', 'readNotificationIds', 'updatedAt',
          'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'revision', 'cutoffCreatedAt', 'cutoffId', 'readNotificationIds', 'updatedAt',
          'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && data.schemaVersion == 1 && data.revision is int && data.revision >= 1
        && data.cutoffCreatedAt is string && data.cutoffCreatedAt.size() >= 20 && data.cutoffCreatedAt.size() <= 40
        && strictId(data.cutoffId) && data.readNotificationIds is list && data.readNotificationIds.size() <= 100
        && data.readNotificationIds.toSet().size() == data.readNotificationIds.size() && data.updatedAt == request.time
        && validSparkPrivateReplay(data, 'notification.read-all');
    }
    function validSparkNotificationReadCursorCreate(data) {
      return validSparkNotificationReadCursor(data) && data.revision == 1;
    }
    function validSparkNotificationReadCursorUpdate(data) {
      return validSparkNotificationReadCursor(data)
        && data.revision == resource.data.revision + 1
        && data.lastOperationId != resource.data.lastOperationId
        && data.lastResourceToken != resource.data.lastResourceToken
        && (data.cutoffCreatedAt > resource.data.cutoffCreatedAt
          || (data.cutoffCreatedAt == resource.data.cutoffCreatedAt && data.cutoffId >= resource.data.cutoffId));
    }
    function groupMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    function groupActive(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('status', 'active') != 'deleted';
    }
    function activeMember(groupId) {
      return groupMember(groupId) && groupActive(groupId);
    }
    function activeMemberOfGroup(data) {
      return signedIn() && data.memberIds is list && request.auth.uid in data.memberIds && data.get('status', 'active') != 'deleted';
    }
    function groupMemberOfGroup(data) {
      return signedIn() && data.memberIds is list && request.auth.uid in data.memberIds;
    }
    function activeManager(groupId) {
      let member = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return signedIn() && groupActive(groupId) && member.status == 'active' && member.canManage == true;
    }
    function lifecycleManager(groupId) {
      let member = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return signedIn() && groupMember(groupId) && member.status == 'active' && member.canManage == true;
    }
    function bounded(maximum) { return request.query.limit != null && request.query.limit > 0 && request.query.limit <= maximum; }

    function validSparkActorShape(actor) {
      return actor is map
        && actor.keys().hasOnly(['id', 'displayName'])
        && strictId(actor.id) && validName(actor.displayName);
    }
    function validSparkCurrentActor(groupId, actor) {
      let member = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return groupActive(groupId) && validSparkActorShape(actor) && actor.id == request.auth.uid && member.status == 'active'
        && actor.displayName == member.displayName;
    }
    function validSparkLifecycleActor(groupId, actor) {
      let member = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return validSparkActorShape(actor) && actor.id == request.auth.uid && member.status == 'active'
        && actor.displayName == member.displayName;
    }
    function validSparkMoney(value, currency, positive) {
      return value.currency == currency && value.currency.matches('^[A-Z]{3}$')
        && value.minorAmount is int && value.minorAmount >= (positive ? 1 : 0)
        && value.minorAmount <= 9007199254740991;
    }
    function validSparkIdList(values, maximum) {
      return values is list && values.size() > 0 && values.size() <= maximum && values.toSet().size() == values.size();
    }
    function validSparkAllocationAt(values, ids, currency, index) {
      return values.size() <= index || (
        values[index].participantId == ids[index]
        && values[index].money.currency == currency
        && values[index].money.minorAmount is int && values[index].money.minorAmount >= 0
        && values[index].money.minorAmount <= 9007199254740991
      );
    }
    function sparkAllocationSum(values) {
      return values.size() == 1 ? values[0].money.minorAmount
        : values.size() == 2 ? values[0].money.minorAmount + values[1].money.minorAmount
        : values.size() == 3 ? values[0].money.minorAmount + values[1].money.minorAmount + values[2].money.minorAmount
        : values.size() == 4 ? values[0].money.minorAmount + values[1].money.minorAmount + values[2].money.minorAmount + values[3].money.minorAmount
        : values.size() == 5 ? values[0].money.minorAmount + values[1].money.minorAmount + values[2].money.minorAmount + values[3].money.minorAmount + values[4].money.minorAmount
        : values[0].money.minorAmount + values[1].money.minorAmount + values[2].money.minorAmount + values[3].money.minorAmount + values[4].money.minorAmount + values[5].money.minorAmount;
    }
    function validSparkAllocations(values, ids, currency, totalMinor) {
      return values is list && validSparkIdList(ids, 6) && values.size() == ids.size()
        && (values.size() == 1
          ? (validSparkAllocationAt(values, ids, currency, 0) && values[0].money.minorAmount == totalMinor)
          : (values.size() == 2
            ? (validSparkAllocationAt(values, ids, currency, 0) && validSparkAllocationAt(values, ids, currency, 1)
              && values[0].money.minorAmount + values[1].money.minorAmount == totalMinor)
            : (validSparkAllocationAt(values, ids, currency, 0) && validSparkAllocationAt(values, ids, currency, 1)
              && validSparkAllocationAt(values, ids, currency, 2) && validSparkAllocationAt(values, ids, currency, 3)
              && validSparkAllocationAt(values, ids, currency, 4) && validSparkAllocationAt(values, ids, currency, 5)
              && sparkAllocationSum(values) == totalMinor)));
    }
    function activeSparkMemberAt(groupId, ids, index) {
      return ids.size() <= index
        || get(/databases/$(database)/documents/groups/$(groupId)/members/$(ids[index])).data.status == 'active';
    }
    function validSparkInvolvedMembers(groupId, ids) {
      return validSparkIdList(ids, 6)
        && activeSparkMemberAt(groupId, ids, 0)
        && activeSparkMemberAt(groupId, ids, 1)
        && activeSparkMemberAt(groupId, ids, 2)
        && activeSparkMemberAt(groupId, ids, 3)
        && activeSparkMemberAt(groupId, ids, 4)
        && activeSparkMemberAt(groupId, ids, 5);
    }
    function validSparkSplitType(value) {
      return value == 'equal' || value == 'exact' || value == 'percentage'
        || value == 'shares' || value == 'adjustment' || value == 'itemized';
    }
    function validSparkRecurrence(value) {
      return value is map && value.keys().hasOnly(['frequency', 'anchor', 'timeZone'])
        && value.keys().hasAll(['frequency', 'anchor', 'timeZone'])
        && (value.frequency == 'weekly' || value.frequency == 'fortnightly'
          || value.frequency == 'monthly' || value.frequency == 'yearly')
        && value.anchor is map && value.anchor.keys().hasOnly(['month', 'day'])
        && value.anchor.keys().hasAll(['month', 'day'])
        && value.anchor.month is int && value.anchor.month >= 1 && value.anchor.month <= 12
        && value.anchor.day is int && value.anchor.day >= 1
        && value.anchor.day <= (value.anchor.month == 2 ? 29
          : (value.anchor.month == 4 || value.anchor.month == 6 || value.anchor.month == 9 || value.anchor.month == 11) ? 30 : 31)
        && value.timeZone is string && value.timeZone.size() > 0 && value.timeZone.size() <= 80;
    }
    function validSparkIsoDate(value) {
      return value is string && value[0:4] != '0000'
        && (value.matches(
            '^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$'
          )
          || value.matches(
            '^([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29$'
          ));
    }
    function sparkTwoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }
    function sparkIsoDateString(year, month, day) {
      return string(year) + '-' + sparkTwoDigits(month) + '-' + sparkTwoDigits(day);
    }
    function sparkIsoDateTimestamp(value) {
      return timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10]));
    }
    function sparkDaysInMonth(year, month) {
      return month == 2
        ? ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0 ? 29 : 28)
        : (month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31);
    }
    function validSparkMonthlyNextOccurrence(currentDate, recurrence, nextDate) {
      let sourceYear = int(currentDate[0:4]);
      let sourceMonth = int(currentDate[5:7]);
      let targetYear = sourceMonth == 12 ? sourceYear + 1 : sourceYear;
      let targetMonth = sourceMonth == 12 ? 1 : sourceMonth + 1;
      let maximumDay = sparkDaysInMonth(targetYear, targetMonth);
      let targetDay = recurrence.anchor.day > maximumDay ? maximumDay : recurrence.anchor.day;
      return nextDate == sparkIsoDateString(targetYear, targetMonth, targetDay);
    }
    function validSparkYearlyNextOccurrence(currentDate, recurrence, nextDate) {
      let targetYear = int(currentDate[0:4]) + 1;
      let maximumDay = sparkDaysInMonth(targetYear, recurrence.anchor.month);
      let targetDay = recurrence.anchor.day > maximumDay ? maximumDay : recurrence.anchor.day;
      return nextDate == sparkIsoDateString(targetYear, recurrence.anchor.month, targetDay);
    }
    function validSparkNextOccurrence(currentDate, recurrence, nextDate) {
      return recurrence.frequency == 'weekly'
          ? sparkIsoDateTimestamp(nextDate) == sparkIsoDateTimestamp(currentDate) + duration.value(7, 'd')
          : (recurrence.frequency == 'fortnightly'
            ? sparkIsoDateTimestamp(nextDate) == sparkIsoDateTimestamp(currentDate) + duration.value(14, 'd')
            : (recurrence.frequency == 'monthly'
              ? validSparkMonthlyNextOccurrence(currentDate, recurrence, nextDate)
              : validSparkYearlyNextOccurrence(currentDate, recurrence, nextDate)));
    }
    function validSparkRecurrenceAnchor(date, recurrence) {
      return validSparkIsoDate(date) && validSparkRecurrence(recurrence)
        && date[5:7] == sparkTwoDigits(recurrence.anchor.month)
        && date[8:10] == sparkTwoDigits(recurrence.anchor.day);
    }
    function validSparkRecurringTemplateId(value) {
      return value is string && value.matches('^recurring-[a-f0-9]{48}$');
    }
    function validSparkExpenseStructure(groupId, expenseId, data) {
      return data.keys().hasOnly([
          'id', 'groupId', 'operationId', 'requestFingerprint', 'resourceToken',
          'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken',
          'description', 'date', 'total', 'payments', 'allocations', 'payerIds', 'participantIds', 'involvedMemberIds',
          'category', 'splitType', 'splitMethod', 'attachmentRefs', 'notes', 'reimbursement',
          'recurrence', 'occurrenceEditScope', 'recurringTemplateId',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'revision', 'deletedAt'
        ])
        && data.id == expenseId && data.groupId == groupId
        && data.resourceToken is string && data.resourceToken.matches('^[a-f0-9]{48}$')
        && (expenseId == 'expense-' + data.resourceToken
          || ('recurringTemplateId' in data
            && expenseId.matches('^occ_recurring-[a-f0-9]{48}_[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.operationId is string && data.operationId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
        && data.requestFingerprint is string && data.requestFingerprint.matches('^[a-f0-9]{64}$')
        && validName(data.description) && validSparkIsoDate(data.date)
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && (!('notes' in data) || (data.notes is string && data.notes.size() > 0 && data.notes.size() <= 5000))
        && (!('reimbursement' in data) || data.reimbursement == true)
        && validSparkSplitType(data.splitType)
        && data.splitMethod.keys().hasOnly(['type', 'allocations']) && data.splitMethod.type == 'exact'
        && (!('recurrence' in data) || validSparkRecurrence(data.recurrence))
        && (!('occurrenceEditScope' in data) || data.occurrenceEditScope == 'occurrence' || data.occurrenceEditScope == 'future')
        && (!('recurringTemplateId' in data) || validSparkRecurringTemplateId(data.recurringTemplateId))
        && data.attachmentRefs == [];
    }
    function validSparkExpensePaymentLedger(data) {
      return validSparkMoney(data.total, data.total.currency, true)
        && validSparkAllocations(data.payments, data.payerIds, data.total.currency, data.total.minorAmount)
        && data.payerIds.toSet().difference(data.involvedMemberIds.toSet()).size() == 0;
