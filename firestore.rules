        && (data.method == 'cash' || data.method == 'bank-transfer' || data.method == 'payment-app' || data.method == 'other')
        && data.occurredOn is string && data.occurredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('note' in data) || (data.note is string && data.note.size() > 0 && data.note.size() <= 2000))
        && data.outsidePaymentConfirmed == true
