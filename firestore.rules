        && activity.kind == 'group.event' && activity.actor == settings.updatedBy && activity.createdAt == request.time
        && activity.subject.keys().hasOnly(['kind', 'id', 'label'])
        && activity.subject.kind == 'group' && activity.subject.id == groupId
        && activity.subject.label == 'Currencies converted to ' + settings.currencyConversion.targetCurrency;
    }
    function validSparkSettingsActivityCreate(groupId, activityId, data) {
      let settings = getAfter(/databases/$(database)/documents/groups/$(groupId)/settings/defaults).data;
      return settings.updatedAt == request.time && (settings.lastCommandKind == 'group.currency-conversion'
        ? validSparkCurrencySettingsActivityData(groupId, activityId, data, settings)
        : validSparkSettingsActivityData(groupId, activityId, data, settings));
    }
    function validSparkBalanceSettingsUpdate(groupId) {
      let beforeSettings = get(/databases/$(database)/documents/groups/$(groupId)/settings/defaults).data;
      let afterSettings = getAfter(/databases/$(database)/documents/groups/$(groupId)/settings/defaults).data;
      return (afterSettings.lastCommandKind == 'group.simplify-debts' || afterSettings.lastCommandKind == 'group.currency-conversion')
        && afterSettings.revision == beforeSettings.revision + 1
        && afterSettings.updatedAt == request.time
        && (afterSettings.lastCommandKind == 'group.currency-conversion'
          ? validSparkCurrencyBalanceAdvance(groupId, beforeSettings, afterSettings)
          : validSparkSettingsBalanceAdvance(groupId, beforeSettings, afterSettings));
    }

    function validNewGroup(groupId, data) {
      return activeAccount() && strictId(groupId)
        && data.keys().hasOnly(['id', 'kind', 'name', 'currency', 'coverImageUrl', 'memberIds', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'kind', 'name', 'currency', 'memberIds', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == groupId && data.kind in ['group', 'friendship'] && validName(data.name)
        && data.currency is string && data.currency.matches('^[A-Z]{3}$')
        && (!('coverImageUrl' in data) || data.coverImageUrl in [
          '/covers/group-trip.jpg', '/covers/group-home.jpg', '/covers/group-couple.jpg', '/covers/group-other.jpg'
        ])
        && data.memberIds == [request.auth.uid] && data.createdByUid == request.auth.uid
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validOwnerMember(data, profile) {
      return data.keys().hasOnly(['status', 'role', 'canManage', 'displayName', 'initials', 'avatarUrl', 'joinedAt'])
        && data.keys().hasAll(['status', 'role', 'canManage', 'displayName', 'initials', 'avatarUrl', 'joinedAt'])
        && data.status == 'active' && data.role == 'owner' && data.canManage == true
        && data.displayName == profile.displayName && data.initials == profile.initials && data.avatarUrl == profile.avatarUrl
        && data.joinedAt == request.time;
    }
    function validJoinMember(data, profile, invitationId) {
      return data.keys().hasOnly(['status', 'role', 'canManage', 'displayName', 'initials', 'avatarUrl', 'invitationId', 'joinedAt'])
        && data.keys().hasAll(['status', 'role', 'canManage', 'displayName', 'initials', 'avatarUrl', 'invitationId', 'joinedAt'])
        && data.status == 'active' && data.role == 'member' && data.canManage == false
        && data.displayName == profile.displayName && data.initials == profile.initials && data.avatarUrl == profile.avatarUrl
        && data.invitationId == invitationId && data.joinedAt == request.time;
    }
    function validSettings(groupId, data) {
      return data.keys().hasOnly(['schemaVersion', 'groupId', 'revision', 'simplifyDebtsEnabled', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'groupId', 'revision', 'simplifyDebtsEnabled', 'updatedAt'])
        && data.schemaVersion == 1 && data.groupId == groupId && data.revision == 1
        && data.simplifyDebtsEnabled == true && data.updatedAt == request.time;
    }
    function validInitialBalance(groupId, data) {
      return data.keys().hasOnly(['groupId', 'balanceRevision', 'simplifyDebtsEnabled', 'pairwise', 'simplified'])
        && data.keys().hasAll(['groupId', 'balanceRevision', 'simplifyDebtsEnabled', 'pairwise', 'simplified'])
        && data.groupId == groupId && data.balanceRevision == 0 && data.simplifyDebtsEnabled == true
        && data.pairwise == [] && data.simplified == [];
    }
    function validOwnerProjection(groupId, data) {
      return data.keys().hasOnly(['groupId', 'status', 'contextLabel', 'joinedAt', 'updatedAt'])
        && data.keys().hasAll(['groupId', 'status', 'contextLabel', 'joinedAt', 'updatedAt'])
        && data.groupId == groupId && data.status == 'active' && validName(data.contextLabel)
        && data.joinedAt == request.time && data.updatedAt == request.time;
    }
    function validJoinProjection(groupId, data, invitationId) {
      return data.keys().hasOnly(['groupId', 'status', 'contextLabel', 'invitationId', 'joinedAt', 'updatedAt'])
        && data.keys().hasAll(['groupId', 'status', 'contextLabel', 'invitationId', 'joinedAt', 'updatedAt'])
        && data.groupId == groupId && data.status == 'active' && validName(data.contextLabel) && data.invitationId == invitationId
        && data.joinedAt == request.time && data.updatedAt == request.time;
    }
    function validFriendCounterpartProjectionUpdate(groupId, uid, data) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let actor = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return signedIn() && uid != request.auth.uid && group.get('kind', 'group') == 'friendship'
        && group.memberIds.size() == 2 && uid in group.memberIds && request.auth.uid in group.memberIds
        && resource.data.status == 'active' && data.status == 'active'
        && data.diff(resource.data).affectedKeys().hasOnly(['contextLabel', 'updatedAt'])
        && validName(data.contextLabel) && actor.status == 'active' && data.contextLabel == actor.displayName
        && data.updatedAt == request.time;
    }
    function ownerBundleExists(groupId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let group = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      let projection = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/groups/$(groupId)).data;
      return validOwnerMember(getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data, profile)
        && validSettings(groupId, getAfter(/databases/$(database)/documents/groups/$(groupId)/settings/defaults).data)
        && validInitialBalance(groupId, getAfter(/databases/$(database)/documents/groups/$(groupId)/balance/current).data)
        && validOwnerProjection(groupId, projection) && projection.contextLabel == group.name;
    }

    function invitationCapabilityId(invitationId) { return invitationId is string && invitationId.matches('^[A-Za-z0-9_-]{43}$'); }
    function validTargetEmail(data) {
      return !('targetEmail' in data) || data.targetEmail == null
        || (data.targetEmail is string && data.targetEmail.size() >= 3 && data.targetEmail.size() <= 254
          && data.targetEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$') && data.targetEmail.matches('^[^A-Z]+$'));
    }
    function targetMatches(data) {
      return !('targetEmail' in data) || data.targetEmail == null
        || (request.auth.token.email_verified == true && request.auth.token.email == data.targetEmail);
    }
    function validNewInvitation(invitationId, data) {
      let group = get(/databases/$(database)/documents/groups/$(data.groupId)).data;
      return invitationCapabilityId(invitationId)
        && data.keys().hasOnly(['schemaVersion', 'invitationId', 'tokenHash', 'groupId', 'groupKind', 'groupName', 'status', 'createdByUid', 'createdByName', 'targetEmail', 'createdAt', 'updatedAt', 'expiresAt'])
        && data.keys().hasAll(['schemaVersion', 'invitationId', 'tokenHash', 'groupId', 'groupKind', 'groupName', 'status', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt', 'expiresAt'])
        && data.schemaVersion == 1 && data.invitationId == invitationId && data.tokenHash == invitationId
        && strictId(data.groupId) && data.groupKind == group.get('kind', 'group') && validName(data.groupName) && validName(data.createdByName) && data.status == 'active' && data.createdByUid == request.auth.uid
        && data.createdByName == get(/databases/$(database)/documents/groups/$(data.groupId)/members/$(request.auth.uid)).data.displayName
        && validTargetEmail(data) && data.createdAt == request.time && data.updatedAt == request.time
        && data.expiresAt is timestamp && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(8, 'd') && activeManager(data.groupId)
        && (group.get('kind', 'group') != 'friendship' || ('targetEmail' in data && data.targetEmail != null && group.memberIds.size() < 2));
    }
    function validUsedInvitation(invitationId, groupId, uid) {
      let before = get(/databases/$(database)/documents/invitations/$(invitationId)).data;
      let after = getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data;
      return invitationCapabilityId(invitationId) && before.invitationId == invitationId && before.groupId == groupId
        && before.status == 'active' && before.expiresAt is timestamp && before.expiresAt > request.time
        && targetMatches(before)
        && after.diff(before).affectedKeys().hasOnly(['status', 'usedByUid', 'usedAt', 'updatedAt'])
        && after.status == 'used' && after.usedByUid == uid
        && after.usedAt == request.time && after.updatedAt == request.time;
    }
    function validAccountDeletionInvitation(data) {
      return accountDeleting() && (
        data.createdByUid == request.auth.uid
        || ('targetEmail' in data && data.targetEmail != null
          && request.auth.token.email_verified == true && request.auth.token.email == data.targetEmail)
      );
    }
    function validInvitationJoin(groupId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let member = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      let projection = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/groups/$(groupId)).data;
      let invitation = get(/databases/$(database)/documents/invitations/$(member.invitationId)).data;
      return validJoinMember(member, profile, member.invitationId)
        && validJoinProjection(groupId, projection, member.invitationId)
        && projection.contextLabel == (invitation.get('groupKind', 'group') == 'friendship' ? invitation.createdByName : invitation.groupName)
        && validUsedInvitation(member.invitationId, groupId, request.auth.uid);
    }
    function validGroupJoin(groupId) {
      return activeAccount() && groupActive(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && !(request.auth.uid in resource.data.memberIds) && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && (resource.data.get('kind', 'group') != 'friendship' || request.resource.data.memberIds.size() == 2)
        && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
        && request.resource.data.updatedAt == request.time && validInvitationJoin(groupId);
    }
    function validGroupLifecycleActivity(groupId, data) {
      let activityId = 'activity-' + data.lastLifecycleResourceToken;
      let activity = getAfter(/databases/$(database)/documents/groups/$(groupId)/activity/$(activityId)).data;
      return activity.keys().hasOnly(['groupId', 'operationId', 'kind', 'subject', 'actor', 'createdAt'])
        && activity.groupId == groupId && activity.operationId == data.lastLifecycleOperationId
        && activity.kind == (data.lastLifecycleCommandKind == 'group.delete' ? 'group.deleted' : 'group.restored')
        && (data.lastLifecycleCommandKind != 'group.delete' || activity.actor == data.deletedBy)
        && validSparkLifecycleActor(groupId, activity.actor) && activity.createdAt == request.time
        && activity.subject.keys().hasOnly(['kind', 'id', 'label'])
        && activity.subject.kind == 'group' && activity.subject.id == groupId && activity.subject.label == data.name;
    }
    function validGroupLifecycleUpdate(groupId) {
      let data = request.resource.data;
      let kind = data.lastLifecycleCommandKind;
      return lifecycleManager(groupId)
        && (kind == 'group.delete' || kind == 'group.restore')
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'deletedAt', 'deletedBy', 'updatedAt',
          'lastLifecycleCommandKind', 'lastLifecycleOperationId', 'lastLifecycleRequestFingerprint', 'lastLifecycleResourceToken'
        ])
        && data.memberIds == resource.data.memberIds && data.name == resource.data.name
        && data.updatedAt == request.time
        && data.lastLifecycleOperationId is string && data.lastLifecycleOperationId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
        && data.lastLifecycleRequestFingerprint is string && data.lastLifecycleRequestFingerprint.matches('^[a-f0-9]{64}$')
        && data.lastLifecycleResourceToken is string && data.lastLifecycleResourceToken.matches('^[a-f0-9]{48}$')
        && data.lastLifecycleOperationId != resource.data.get('lastLifecycleOperationId', '')
        && data.lastLifecycleResourceToken != resource.data.get('lastLifecycleResourceToken', '')
        && (
          (kind == 'group.delete' && resource.data.get('status', 'active') != 'deleted'
            && data.status == 'deleted' && data.deletedAt == request.time
            && validSparkLifecycleActor(groupId, data.deletedBy))
          || (kind == 'group.restore' && resource.data.get('status', 'active') == 'deleted'
            && data.status == 'active' && !('deletedAt' in data) && !('deletedBy' in data))
        )
        && validGroupLifecycleActivity(groupId, data);
    }
    function validSparkLifecycleActivityCreate(groupId, activityId, data) {
      let group = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      return activityId == 'activity-' + group.lastLifecycleResourceToken
        && group.updatedAt == request.time && validGroupLifecycleActivity(groupId, group)
        && data == getAfter(/databases/$(database)/documents/groups/$(groupId)/activity/$(activityId)).data;
    }
    function validRemovedMemberDocument(groupId, uid, data) {
      let group = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      return uid == group.lastRemovedMemberId && uid != request.auth.uid
        && data.keys().hasOnly([
          'status', 'role', 'canManage', 'displayName', 'initials', 'avatarUrl', 'invitationId', 'joinedAt',
          'removedByUid', 'removedAt', 'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ])
        && data.status == 'removed' && data.role == 'member' && data.canManage == false
        && data.removedByUid == request.auth.uid && data.removedAt == request.time
        && data.lastCommandKind == 'group.member-remove'
        && data.lastOperationId == group.lastMembershipOperationId
        && data.lastRequestFingerprint == group.lastMembershipRequestFingerprint
        && data.lastResourceToken == group.lastMembershipResourceToken;
    }
    function validTargetMemberRemoval(groupId, uid, data) {
      return activeManager(groupId) && resource.data.status == 'active' && resource.data.role == 'member'
        && resource.data.canManage == false && validRemovedMemberDocument(groupId, uid, data)
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'removedByUid', 'removedAt', 'lastCommandKind', 'lastOperationId', 'lastRequestFingerprint', 'lastResourceToken'
        ]);
    }
    function validTargetProjectionRemoval(groupId, uid, data) {
      let group = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      let member = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data;
      return activeManager(groupId) && uid == group.lastRemovedMemberId && uid != request.auth.uid
        && resource.data.groupId == groupId && resource.data.status == 'active'
        && data.groupId == groupId && data.status == 'removed'
        && data.removedByUid == request.auth.uid && data.removedAt == request.time && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'removedByUid', 'removedAt', 'updatedAt'])
        && validRemovedMemberDocument(groupId, uid, member);
    }
    function validGroupMemberRemoval(groupId) {
      let data = request.resource.data;
      let target = data.lastRemovedMemberId;
      let member = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(target)).data;
      let projection = getAfter(/databases/$(database)/documents/users/$(target)/groups/$(groupId)).data;
      let settings = getAfter(/databases/$(database)/documents/groups/$(groupId)/settings/defaults).data;
      return activeManager(groupId) && strictId(target) && target != request.auth.uid && target != resource.data.createdByUid
        && data.keys().hasOnly([
          'id', 'kind', 'name', 'currency', 'coverImageUrl', 'memberIds', 'createdByUid', 'createdAt', 'updatedAt',
          'lastMembershipCommandKind', 'lastMembershipOperationId', 'lastMembershipRequestFingerprint',
          'lastMembershipResourceToken', 'lastRemovedMemberId'
        ])
        && data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds', 'updatedAt', 'lastMembershipCommandKind', 'lastMembershipOperationId',
          'lastMembershipRequestFingerprint', 'lastMembershipResourceToken', 'lastRemovedMemberId'
        ])
        && target in resource.data.memberIds && !(target in data.memberIds)
        && data.memberIds.size() == resource.data.memberIds.size() - 1
        && data.memberIds.toSet().union([target].toSet()) == resource.data.memberIds.toSet()
        && data.updatedAt == request.time && data.lastMembershipCommandKind == 'group.member-remove'
        && data.lastMembershipOperationId is string && data.lastMembershipOperationId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
        && data.lastMembershipRequestFingerprint is string && data.lastMembershipRequestFingerprint.matches('^[a-f0-9]{64}$')
        && data.lastMembershipResourceToken is string && data.lastMembershipResourceToken.matches('^[a-f0-9]{48}$')
        && validRemovedMemberDocument(groupId, target, member)
        && projection.status == 'removed' && projection.removedByUid == request.auth.uid
        && projection.removedAt == request.time && projection.updatedAt == request.time
        && settings.lastCommandKind == 'group.member-remove'
        && settings.lastOperationId == data.lastMembershipOperationId
        && settings.lastRequestFingerprint == data.lastMembershipRequestFingerprint
        && settings.lastResourceToken == data.lastMembershipResourceToken;
    }
    function validDeletedAccountMember(before, after, uid) {
      return uid == request.auth.uid && before.status == 'active' && after.status == 'removed'
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'role', 'canManage', 'displayName', 'initials', 'avatarUrl', 'accountStatus',
          'accountDeletionId', 'accountDeletedAt'
        ])
        && after.role == 'member' && after.canManage == false
        && after.displayName == 'Deleted user' && after.initials == 'DU' && after.avatarUrl == null
        && after.accountStatus == 'deleted' && after.accountDeletionId == currentAccountDeletionId()
        && after.accountDeletedAt == request.time;
    }
    function validPromotedAccountMember(groupId, before, after, uid) {
      let group = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      return accountDeletingInGroup(groupId) && uid != request.auth.uid
        && group.createdByUid == uid && group.lastDeletedAccountUid == request.auth.uid
        && before.status == 'active' && before.get('accountStatus', '') != 'deleted'
        && after.diff(before).affectedKeys().hasOnly([
          'role', 'canManage', 'accountDeletionPromotionId', 'accountDeletionPromotedAt'
        ])
        && after.status == 'active' && after.role == 'owner' && after.canManage == true
        && after.accountDeletionPromotionId == currentAccountDeletionId()
        && after.accountDeletionPromotedAt == request.time;
    }
    function validAccountDeletionGroup(groupId, data) {
      let beforeMember = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      let afterMember = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      let transferred = data.createdByUid != resource.data.createdByUid;
      let promotedBefore = get(/databases/$(database)/documents/groups/$(groupId)/members/$(data.createdByUid)).data;
      let promotedAfter = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(data.createdByUid)).data;
      return accountDeletingInGroup(groupId) && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in data.memberIds)
        && data.memberIds.size() == resource.data.memberIds.size() - 1
        && data.memberIds.toSet().union([request.auth.uid].toSet()) == resource.data.memberIds.toSet()
        && data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds', 'createdByUid', 'status', 'deletedAt', 'deletedBy', 'updatedAt',
          'lastAccountDeletionId', 'lastDeletedAccountUid'
        ])
        && data.updatedAt == request.time && data.lastAccountDeletionId == currentAccountDeletionId()
        && data.lastDeletedAccountUid == request.auth.uid
        && validDeletedAccountMember(beforeMember, afterMember, request.auth.uid)
        && (
          (transferred && data.createdByUid != request.auth.uid && data.createdByUid in data.memberIds
            && data.get('status', 'active') == resource.data.get('status', 'active')
            && data.get('deletedAt', null) == resource.data.get('deletedAt', null)
            && data.get('deletedBy', null) == resource.data.get('deletedBy', null)
            && validPromotedAccountMember(groupId, promotedBefore, promotedAfter, data.createdByUid))
          || (!transferred && resource.data.createdByUid != request.auth.uid
            && data.get('status', 'active') == resource.data.get('status', 'active')
            && data.get('deletedAt', null) == resource.data.get('deletedAt', null)
            && data.get('deletedBy', null) == resource.data.get('deletedBy', null))
          || (!transferred && resource.data.createdByUid == request.auth.uid && resource.data.memberIds.size() == 1
            && resource.data.get('status', 'active') == 'active'
            && data.status == 'deleted' && data.deletedAt == request.time && validDeletedActor(data.deletedBy))
        );
    }
    function validAccountDeletionFriendProjection(groupId, uid, data) {
      let beforeGroup = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let group = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      let deletedMember = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
      return accountDeletingInGroup(groupId) && uid != request.auth.uid
        && group.kind == 'friendship' && uid in group.memberIds
        && request.auth.uid in beforeGroup.memberIds && !(request.auth.uid in group.memberIds)
        && deletedMember.accountStatus == 'deleted' && deletedMember.displayName == 'Deleted user'
        && resource.data.status == 'active' && data.status == 'active'
        && data.diff(resource.data).affectedKeys().hasOnly([
          'contextLabel', 'updatedAt', 'accountDeletionId', 'accountDeletedUid'
        ])
        && data.contextLabel == 'Deleted user' && data.updatedAt == request.time
        && data.accountDeletionId == currentAccountDeletionId()
        && data.accountDeletedUid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owns(uid) && (
        (activeAccount() && validSparkProfileUpdate(request.resource.data))
        || validAccountDeletionStart(request.resource.data)
        || validAccountDeletionTransition(request.resource.data)
      );

      match /groups/{groupId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && bounded(100);
        allow create: if owns(uid) && (
          (validOwnerProjection(groupId, request.resource.data)
            && validNewGroup(groupId, getAfter(/databases/$(database)/documents/groups/$(groupId)).data))
          || (validJoinProjection(groupId, request.resource.data, request.resource.data.invitationId)
            && validUsedInvitation(request.resource.data.invitationId, groupId, uid))
        );
        allow update: if 'accountDeletionId' in request.resource.data
          ? validAccountDeletionFriendProjection(groupId, uid, request.resource.data)
          : (validFriendCounterpartProjectionUpdate(groupId, uid, request.resource.data)
            || validTargetProjectionRemoval(groupId, uid, request.resource.data));
        allow delete: if accountDeletionOwnsPrivateData(uid);
      }
      match /activity/{activityId} {
        allow get: if owns(uid); allow list: if owns(uid) && bounded(100);
        allow delete: if accountDeletionOwnsPrivateData(uid); allow create, update: if false;
      }
      match /notifications/{notificationId} {
        allow get: if owns(uid); allow list: if owns(uid) && bounded(100);
        allow delete: if accountDeletionOwnsPrivateData(uid); allow create, update: if false;
      }
      match /notificationReads/{notificationId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && bounded(100);
        allow create: if validSparkNotificationReadReceipt(uid, notificationId, request.resource.data);
        allow delete: if accountDeletionOwnsPrivateData(uid); allow update: if false;
      }
      match /settings/{settingId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && bounded(100);
        allow delete: if accountDeletionOwnsPrivateData(uid);
        allow create: if owns(uid) && (
          (settingId == 'notifications' && validSparkNotificationPreferencesCreate(request.resource.data))
          || (settingId == 'sparkNotificationReadCursor' && validSparkNotificationReadCursorCreate(request.resource.data))
        );
        allow update: if owns(uid) && (
          (settingId == 'notifications' && validSparkNotificationPreferencesUpdate(request.resource.data))
          || (settingId == 'sparkNotificationReadCursor' && validSparkNotificationReadCursorUpdate(request.resource.data))
        );
      }
      match /jobs/{jobId} {
        allow get: if owns(uid); allow list: if owns(uid) && bounded(50);
        allow delete: if accountDeletionOwnsPrivateData(uid); allow create, update: if false;
      }
      match /exports/{jobId} {
        allow get: if owns(uid); allow list: if owns(uid) && bounded(50);
        allow delete: if accountDeletionOwnsPrivateData(uid); allow create, update: if false;
      }
      match /devices/{deviceId} {
        allow get: if owns(uid); allow list: if owns(uid) && bounded(25);
        allow delete: if accountDeletionOwnsPrivateData(uid); allow create, update: if false;
      }
      match /operations/{operationId} { allow read, write: if false; }
    }

    match /groups/{groupId} {
      allow get: if groupMemberOfGroup(resource.data)
        || accountDeletionGroupRead(groupId);
      allow list, delete: if false;
      allow create: if validNewGroup(groupId, request.resource.data) && ownerBundleExists(groupId);
      allow update: if 'lastAccountDeletionId' in request.resource.data
        ? validAccountDeletionGroup(groupId, request.resource.data)
        : (validGroupJoin(groupId) || validGroupMemberRemoval(groupId) || validGroupLifecycleUpdate(groupId));

      match /members/{uid} {
        allow get: if groupMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (groupMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if owns(uid) && (
          (validNewGroup(groupId, getAfter(/databases/$(database)/documents/groups/$(groupId)).data)
            && validOwnerMember(request.resource.data, get(/databases/$(database)/documents/users/$(uid)).data))
          || (validJoinMember(request.resource.data, get(/databases/$(database)/documents/users/$(uid)).data, request.resource.data.invitationId)
            && validUsedInvitation(request.resource.data.invitationId, groupId, uid))
        );
        allow update: if 'accountDeletionId' in request.resource.data
          ? (accountDeletingInGroup(groupId)
            && validDeletedAccountMember(resource.data, request.resource.data, uid))
          : ('accountDeletionPromotionId' in request.resource.data
            ? validPromotedAccountMember(groupId, resource.data, request.resource.data, uid)
            : ((owns(uid) && resource.data.status == 'active'
                && request.resource.data.status == 'active'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'initials', 'avatarUrl'])
                && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName
                && request.resource.data.initials == getAfter(/databases/$(database)/documents/users/$(uid)).data.initials
                && request.resource.data.avatarUrl == getAfter(/databases/$(database)/documents/users/$(uid)).data.avatarUrl
                && getAfter(/databases/$(database)/documents/users/$(uid)).data.updatedAt == request.time
                && validSparkPrivateReplay(getAfter(/databases/$(database)/documents/users/$(uid)).data, 'profile.update'))
              || validTargetMemberRemoval(groupId, uid, request.resource.data)));
        allow delete: if false;
      }
      match /expenses/{expenseId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if (expenseId.matches('^occ_.*$')
            ? validSparkRecurringOccurrenceCreate(groupId, expenseId, request.resource.data)
            : validSparkExpenseCreate(groupId, expenseId, request.resource.data));
        allow update: if (('current' in request.resource.data
              && 'occurrenceEditScope' in request.resource.data.current
              && request.resource.data.current.occurrenceEditScope == 'future')
            ? validSparkFutureExpenseHeadUpdate(groupId, expenseId, request.resource.data)
            : validSparkExpenseHeadUpdate(groupId, expenseId, request.resource.data))
          || validAccountDeletionExpense(groupId, request.resource.data);
        allow delete: if false;
        match /revisions/{revisionId} {
          allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
          allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
          allow create: if ('expense' in request.resource.data
              && 'occurrenceEditScope' in request.resource.data.expense
              && request.resource.data.expense.occurrenceEditScope == 'future')
            ? validSparkFutureExpenseVersionCreate(groupId, expenseId, revisionId, request.resource.data)
            : validSparkExpenseVersionCreate(groupId, expenseId, revisionId, request.resource.data);
          allow update: if validAccountDeletionRevision(groupId, request.resource.data);
          allow delete: if false;
        }
      }
      match /comments/{commentId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if validSparkCommentCreate(groupId, commentId, request.resource.data);
        allow update: if validSparkCommentDelete(groupId, commentId, request.resource.data)
          || validAccountDeletionComment(groupId, request.resource.data);
        allow delete: if false;
      }
      match /settlements/{settlementId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if validSparkSettlementCreate(groupId, settlementId, request.resource.data);
        allow update: if validSparkSettlementUpdate(groupId, settlementId, request.resource.data)
          || validAccountDeletionSettlement(groupId, request.resource.data);
        allow delete: if false;
      }
      match /activity/{activityId} {
        allow get: if groupMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (groupMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if request.resource.data.kind == 'expense.created'
            || request.resource.data.kind == 'expense.updated'
            || request.resource.data.kind == 'expense.deleted'
          ? validSparkExpenseActivityCreate(groupId, activityId, request.resource.data)
          : ((request.resource.data.kind == 'group.event' || request.resource.data.kind == 'membership.changed')
            ? validSparkSettingsActivityCreate(groupId, activityId, request.resource.data)
            : ((request.resource.data.kind == 'group.deleted' || request.resource.data.kind == 'group.restored')
              ? validSparkLifecycleActivityCreate(groupId, activityId, request.resource.data)
              : ((request.resource.data.kind == 'comment.added' || request.resource.data.kind == 'comment.deleted')
                ? validSparkCommentActivityCreate(groupId, activityId, request.resource.data)
                : ((request.resource.data.kind == 'settlement.created' || request.resource.data.kind == 'settlement.voided')
                  && validSparkSettlementActivityCreate(groupId, activityId, request.resource.data)))));
        allow update: if validAccountDeletionActivity(groupId, request.resource.data);
        allow delete: if false;
      }
      match /balance/{snapshotId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId); allow list, delete: if false;
        allow update: if snapshotId == 'current' && validSparkBalanceSettingsUpdate(groupId);
        allow create: if snapshotId == 'current' && validInitialBalance(groupId, request.resource.data)
          && validNewGroup(groupId, getAfter(/databases/$(database)/documents/groups/$(groupId)).data);
      }
      match /settings/{settingId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId); allow list, delete: if false;
        allow update: if settingId == 'defaults' && ('accountDeletionId' in request.resource.data
          ? validAccountDeletionSettings(groupId, request.resource.data)
          : ((request.resource.data.lastCommandKind == 'group.currency-conversion'
              ? validSparkCurrencySettingsDocumentUpdate(groupId, request.resource.data)
              : validSparkSettingsUpdate(groupId, request.resource.data))
            || validAccountDeletionSettingsActor(groupId, request.resource.data)));
        allow create: if settingId == 'defaults' && validSettings(groupId, request.resource.data)
          && validNewGroup(groupId, getAfter(/databases/$(database)/documents/groups/$(groupId)).data);
      }
      match /currencyConversions/{conversionId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if validSparkCurrencyConversionCreate(groupId, conversionId, request.resource.data);
        allow update, delete: if false;
        match /rates/{sourceCurrency} {
          allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
          allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(6);
          allow create: if validSparkCurrencyRateCreate(groupId, conversionId, sourceCurrency, request.resource.data);
          allow update, delete: if false;
        }
      }
      match /recurringTemplates/{templateId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
        allow list: if (activeMember(groupId) || accountDeletionGroupRead(groupId)) && bounded(100);
        allow create: if validSparkRecurringTemplateCreate(groupId, templateId, request.resource.data);
        allow update: if 'accountDeletionId' in request.resource.data
          ? validAccountDeletionRecurring(groupId, request.resource.data)
          : validSparkRecurringTemplateUpdate(groupId, templateId, request.resource.data);
        allow delete: if false;
      }
      match /assets/{assetId} {
        allow get: if activeMember(groupId) || accountDeletionGroupRead(groupId);
        allow list, write: if false;
      }
    }

    match /invitations/{invitationId} {
      allow get: if invitationCapabilityId(invitationId) && (activeAccount() || accountDeleting());
      allow list: if validAccountDeletionInvitation(resource.data) && bounded(100);
      allow delete: if validAccountDeletionInvitation(resource.data);
      allow create: if activeAccount() && validNewInvitation(invitationId, request.resource.data);
      allow update: if activeAccount() && (
        validUsedInvitation(invitationId, resource.data.groupId, request.auth.uid)
        || (activeManager(resource.data.groupId) && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedByUid', 'revokedAt', 'updatedAt'])
          && request.resource.data.status == 'revoked' && request.resource.data.revokedByUid == request.auth.uid
          && request.resource.data.revokedAt == request.time && request.resource.data.updatedAt == request.time)
      );
    }

    match /{document=**} { allow read, write: if false; }
  }
}
