        : split.participantIds.size() == 4 ? ratios[split.participantIds[0]] + ratios[split.participantIds[1]] + ratios[split.participantIds[2]] + ratios[split.participantIds[3]]
        : split.participantIds.size() == 5 ? ratios[split.participantIds[0]] + ratios[split.participantIds[1]] + ratios[split.participantIds[2]] + ratios[split.participantIds[3]] + ratios[split.participantIds[4]]
        : ratios[split.participantIds[0]] + ratios[split.participantIds[1]] + ratios[split.participantIds[2]] + ratios[split.participantIds[3]] + ratios[split.participantIds[4]] + ratios[split.participantIds[5]];
